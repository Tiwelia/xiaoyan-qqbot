# Altare 配置模板：复制为 .env 后填写；已有 .env 时不要覆盖。
# .env 保存真实密钥，请勿分享。系统环境变量优先于此文件。

# 1. 必填：QQ 开放平台与 DeepSeek 的凭证
QQBOT_APPID=
QQBOT_SECRET=
DEEPSEEK_API_KEY=

# 2. 模型（2026-11 实测 /models 得到的线上型号）
LLM_BASE_URL=https://api.deepseek.com
# auto 按官方域名识别服务；自建 DeepSeek/OpenRouter 中转可显式指定对应协议。
# LLM_PROVIDER=auto
# OpenRouter：LLM_BASE_URL=https://openrouter.ai/api/v1，LLM_MODEL=组织/模型
OPENROUTER_API_KEY=
# 显式通用密钥 LLM_API_KEY 优先；不会把 DEEPSEEK_API_KEY 自动用于 OpenRouter。
# deepseek-flash   DeepSeek-V4.1-Flash，1M 上下文，输入支持 text + image
# deepseek-v4-pro  DeepSeek-V4-Pro，1M 上下文，输入只有 text
LLM_MODEL=deepseek-flash
# 图片理解只能走支持图片输入的型号；DeepSeek 这边就是 flash，填 pro 会一直 400
LLM_VISION_MODEL=deepseek-flash
# 独立视觉服务：默认沿用主模型；预留 OpenRouter 时先只填 OPENROUTER_API_KEY。
# 以后启用时改下面两项，主聊天模型不变：
# LLM_VISION_PROVIDER=openrouter
# LLM_VISION_MODEL=组织/支持图片的模型ID
# OpenRouter 默认 https://openrouter.ai/api/v1；中转可单独指定地址和密钥：
# LLM_VISION_BASE_URL=https://openrouter.ai/api/v1
# LLM_VISION_API_KEY=
# 独立视觉服务默认跟随服务默认思考设置，不继承主模型的 /effort 档位。
# auto 跟随服务默认；enabled 开启思考；disabled 关闭思考。非 DeepSeek 服务建议 auto。
# auto / enabled / disabled；disabled 就是完全不思考（最听指令）
LLM_THINKING=disabled
# 思考深度 low / high / max；留空沿用服务默认（high）
# LLM_EFFORT=high
LLM_MAX_TOKENS=8192
# 思考模式下 temperature 不生效。
LLM_TEMPERATURE=1

# 3. 模式与常用行为（默认个人单聊）
# 个人专用：仅接受绑定主人的私聊，不接收群聊。
SCOPE_MODE=c2c
# 保持 disabled；个人专用版启动时会检查。
GROUP_MODE=disabled
# 留空时首次上线从控制台取得 /bind 一次性指令；绑定保存在 data/owner.json。
# 已知主人在机器人事件里的 OpenID 时可直接填写（不是 QQ 号）。
OWNER_OPENID=
# 此处 open 只表示 SDK 接收入口；应用层仍仅允许已绑定主人。
C2C_MODE=open
REQUIRE_MENTION=false
STREAMING=true
MEMORY_ENABLED=true
ENABLE_REMEMBER_TOOL=true
# 保留的消息条数，不是对话轮数；20 条约为 10 轮。
HISTORY_LIMIT=20
REPLY_TIMEOUT_MS=240000
# /long 的生成与上传总超时，和普通聊天分开。
LONG_REPLY_TIMEOUT_MS=900000
# 默认关闭；语音回复始终跳过输入中提示，为文字和语音保留名额。
TYPING_INDICATOR=false
# 每个 peer 的防刷：冷却毫秒 + 每分钟条数（0 = 关闭）。单聊可以放宽。
PEER_COOLDOWN_MS=300
PEER_RATE_PER_MIN=30

# 交流习惯与主动聊天：只联系已经绑定且与机器人说过话的主人。
CHAT_NATURAL=true
PROACTIVE_ENABLED=true
PROACTIVE_DAILY_MAX=4
# 上次对话结束 90～180 分钟后，才考虑主动找话题；不是固定次数保证。
PROACTIVE_MIN_IDLE_MINUTES=90
PROACTIVE_MAX_IDLE_MINUTES=180
# 按 TZ（默认 Asia/Shanghai）计算。没收到回复时，不连续追发。
PROACTIVE_QUIET_START=23
PROACTIVE_QUIET_END=9
# 直接说「先别主动找我」暂停，说「恢复主动聊天」恢复；「晚安」「我先忙了」会暂缓。

TTS_ENGINE=qwen
# 句间硬停顿（SSML）：同一段话 48s → 55s，多出来的是呼吸
TTS_SSML=true
TTS_PAUSE_MS=600
TTS_API_KEY=
# 系统音色 id（/voice list 看全部）或复刻音色名（scripts/voice-clone.mjs 登记）
TTS_VOICE=longanlingxin_v3.1
# 留空：qwen 的 instruction 会导致音量/语气跳变，加戏走 [whispers] 这类官方标签
TTS_STYLE=
# 资源闸门：同时合成 3 个、排队 8 个，超了直接回「忙」而不是堆内存
TTS_MAX_CONCURRENCY=3
TTS_QUEUE_MAX=8
TTS_TIMEOUT_MS=30000
# 一次最多念多少字（≈8 分钟；长回复整段合成后按体积切成几条语音条）
# 合成时的分段粒度：单段 200 字约 45 秒
TTS_MAX_CHARS=8000
TTS_SEGMENT_CHARS=600
TTS_SEGMENTS_MAX=3
# 音频字节上限与同一 peer 的冷却
TTS_MAX_BYTES=16777216
TTS_COOLDOWN_MS=2000
# 临时音频：保留时长 + 目录总大小上限（发送后立即删，这里是崩了之后的兜底）
TTS_TTL_MINUTES=60
TTS_TMP_MAX_MB=256
TTS_SWEEP_MS=300000
# 新会话默认就开语音（不用每次 /voice 打开）
TTS_DEFAULT_ON=true
# 长语音：/long 用。单段 200 字、拼成一条整音频后按体积切成几条语音条发。
# QQ 语音条软上限 20MB（超了平台自动降级成文件卡片），所以 10 分钟 24kHz 会切成 2 条。
TTS_LONG_MAX_MINUTES=15
# 段与段之间留多少毫秒静音（ASMR 的呼吸感）
TTS_LONG_GAP_MS=250
# 语音条 / 文件 / auto（先语音条，失败退回文件）
TTS_LONG_DELIVERY=auto
# 拼好的整条音频体积上限
TTS_LONG_MAX_MB=64
# 单条语音条的目标体积（留 2MB 余量给平台的 20MB 软限）
TTS_VOICE_SOFT_LIMIT_MB=18
# 语速估算：每秒多少字（冰糖实测约 4.9），用来把「几分钟」换算成字数
TTS_CHARS_PER_SECOND=4.9
TTS_TMP_DIR=./data/tmp/tts
# 换引擎时改这两组
# 通义 Qwen-Audio-TTS（阿里云百炼 / DashScope），TTS_ENGINE=qwen 时启用
#   qwen-audio-3.1-tts-flash  默认：88 个音色全支持、更快
#   qwen-audio-3.1-tts-plus   质量档，但只认 longanlingxin / longanhuan / longanfengyue 三个音色
# 音色 88 个系统音色，/voice list 里能看到；不支持直接喂本地音源克隆。
# TTS_STYLE 会作为 input.instruction 发过去（语速/情绪会变，实测有效）。
# 国际站（新加坡）：https://dashscope-intl.aliyuncs.com/api/v1
# 国内站（北京）：https://dashscope.aliyuncs.com/api/v1（默认）
# TTS_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# TTS_QWEN_API_KEY=
# TTS_QWEN_MODEL=qwen-audio-3.1-tts-flash
# TTS_QWEN_VOICE=anruorou_v3.1
# TTS_QWEN_SAMPLE_RATE=24000
# TTS_OPENAI_BASE_URL=https://api.openai.com/v1
# TTS_OPENAI_MODEL=tts-1
# TTS_OPENAI_VOICE=alloy

# 5. 指令与越狱兜底
COMMANDS_ENABLED=true
# 指令前缀，逗号分隔
# COMMAND_PREFIXES=/,／
UNCENSOR_ENABLED=true
UNCENSOR_RETRIES=3
UNCENSOR_RETRY_ON_FILTER=true

# 6. 记忆分档与严格写入
# 严格模式：禁掉 event（流水账）、加禁止清单、加长度封顶。旧版乱记就是缺这层。
MEMORY_STRICT=true
# 单条记忆最多多少字，超了截断
MEMORY_MAX_CONTENT=200
# 群聊注入范围：off 不注入 / limited 只注入 all+group / full 全量（SCOPE_MODE=c2c 时用不到）
MEMORY_GROUP_MODE=limited
MEMORY_GROUP_WRITE_SCOPE=group
# 新开会话注入多少条（全量快照），老会话每轮注入多少条（压缩版）
MEMORY_INJECT_LIMIT=30
MEMORY_INJECT_MAX_CHARS=8000
MEMORY_WARM_INJECT_LIMIT=8
MEMORY_WARM_INJECT_CHARS=1200

# 7. 高级设置：通常保留默认，需要时取消注释
# LLM_TIMEOUT_MS=180000
# LLM_MAX_TOOL_ROUNDS=4
# MAX_CONCURRENCY=4
# HISTORY_BYTES=64000
# GROUP_HISTORY_LIMIT=10
# TEXT_CHUNK_LIMIT=4500
# TYPING_INDICATOR=true
# QQBOT_MARKDOWN=true
# C2C_ALLOW=
# LOG_CONVERSATION=false
# DEBUG=false
# TZ=Asia/Shanghai

# Altare 数据保存在项目目录内；不要改成 Railway 的 /data。
# 表情包 / 图片素材：丢进 data/assets/，文件名就是它的名字（猫猫头.png → send_image 的 name 填「猫猫头」）
ASSETS_ENABLED=true
ASSETS_DIR=./data/assets
ASSETS_MAX_MB=20

# 场景音频生成（阿里云 qwen-audio-3.1-tts-next）：一段描述里同时写台词、语气、雨声/呼吸，
# 一次出一条两分钟以内的带环境音音频，直接当语音条发。key 复用 TTS_QWEN_API_KEY。
SCENE_ENABLED=false
SCENE_MODEL=qwen-audio-3.1-tts-next
# 单次下载体积上限与生成超时（120 秒音频约 160 秒出）
SCENE_MAX_SECONDS=120
SCENE_MAX_MB=32
SCENE_TIMEOUT_MS=300000
SCENE_TMP_DIR=./data/tmp/scene
DATA_DIR=./data
SESSION_DIR=./data/sessions
MEMORY_DB=./data/memory/xiaoyan-memory.db
MEMORY_SEED=
STATE_FILE=./data/state.json
# 使用其他兼容服务时，填写 LLM_API_KEY（优先）或该服务专用 key。
# LLM_API_KEY=
# QQBOT_BASE_URL 仅供测试使用，不要填 QQ 文档网址。










